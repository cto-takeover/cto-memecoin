{
  "name": "cto-memecoin",
  "private": true,
  "type": "module",
  "scripts": {
    "build:contract": "cargo near build non-reproducible-wasm --manifest-path contract/Cargo.toml",
    "gen:reference": "node scripts/gen-reference.mjs",
    "check:reference": "node scripts/gen-reference.mjs --check",
    "test:relayer": "npm run check:reference && python3 scripts/gen-faces.py --check && npm run build:contract && npm --prefix web run typecheck && npm --prefix web run test:relayer",
    "gen:faces": "python3 scripts/gen-faces.py",
    "dev:chain": "npm run build:contract && node scripts/dev-chain.mjs",
    "dev": "npm --prefix web run dev",
    "build:web": "npm --prefix web run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0"
  }
}
