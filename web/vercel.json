{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }],
  "headers": [
    { "source": "/sim/(.*)", "headers": [{ "key": "cache-control", "value": "public, max-age=300" }] },
    { "source": "/api/demo/(take-seat|announce)", "headers": [{ "key": "cache-control", "value": "no-store" }] }
  ]
}
